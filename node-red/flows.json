  {
    "id": "mqtt-telemetry",
    "type": "mqtt in",
    "z": "cold-chain-tab",
    "name": "Telemetria dos dispositivos",
    "topic": "cold-chain/+/telemetry",
    "qos": "1",
    "datatype": "auto",
    "broker": "local-mosquitto",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 120,
    "wires": [["validate-and-route"]]
  },
  {
    "id": "validate-and-route",
    "type": "function",
    "z": "cold-chain-tab",
    "name": "Validar telemetria e avaliar alarmes",
    "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (error) {\n        node.warn('JSON MQTT invalido: ' + error.message);\n        return null;\n    }\n}\nconst id = p && (p.device_id || msg.topic.split('/')[1]);\nif (!id || !Number.isFinite(p.temperature_c) || !Number.isFinite(p.humidity_pct) || typeof p.door_open !== 'boolean') {\n    node.warn('Telemetria invalida em ' + msg.topic);\n    return null;\n}\nconst now = Date.now();\nconst out = [\n    { payload: p.temperature_c },\n    { payload: p.humidity_pct },\n    { payload: p.temperature_c, topic: id },\n    { payload: p.humidity_pct, topic: id },\n    { payload: p.door_open ? 'ABERTA' : 'FECHADA' },\n    null\n];\nlet alarm = null;\nconst temperatureOutOfRange = p.temperature_c < 2 || p.temperature_c > 8;\nconst wasOutOfRange = context.get('temperatureAlarm:' + id) === true;\nif (temperatureOutOfRange && !wasOutOfRange) {\n    alarm = { code: 'temperature_excursion', message: 'Temperatura fora da faixa de 2 a 8 C', value: p.temperature_c };\n} else if (!temperatureOutOfRange && wasOutOfRange) {\n    alarm = { code: 'temperature_restored', message: 'Temperatura voltou para a faixa de 2 a 8 C', value: p.temperature_c };\n}\ncontext.set('temperatureAlarm:' + id, temperatureOutOfRange);\nlet doorOpenedAt = context.get('doorOpenedAt:' + id);\nif (p.door_open) {\n    if (!doorOpenedAt) {\n        doorOpenedAt = now;\n        context.set('doorOpenedAt:' + id, doorOpenedAt);\n    }\n    if (now - doorOpenedAt >= 30000 && context.get('doorAlarm:' + id) !== true) {\n        alarm = { code: 'door_open_too_long', message: 'Porta aberta por mais de 30 segundos' };\n        context.set('doorAlarm:' + id, true);\n    }\n} else {\n    context.set('doorOpenedAt:' + id, null);\n    context.set('doorAlarm:' + id, false);\n}\nif (alarm) {\n    out[5] = { topic: 'cold-chain/' + id + '/alarms', payload: JSON.stringify({ device_id: id, ...alarm, timestamp: new Date(now).toISOString() }) };\n}\nreturn out;",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 490,
    "y": 120,
    "wires": [
      ["temperature-gauge"],
      ["humidity-gauge"],
      ["temperature-chart"],
      ["humidity-chart"],
      ["door-status"],
      ["mqtt-alarm-out"]
    ]
  },
