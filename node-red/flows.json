  {
    "id": "format-alarm",
    "type": "function",
    "z": "cold-chain-tab",
    "name": "Formatar evento",
    "func": "let event = msg.payload;\nif (typeof event === 'string') {\n    try { event = JSON.parse(event); } catch (error) {\n        node.warn('Evento de alarme invalido: ' + error.message);\n        return null;\n    }\n}\nif (!event || !event.code || !event.message) {\n    node.warn('Evento de alarme sem codigo ou mensagem');\n    return null;\n}\nmsg.payload = event.code + ': ' + event.message;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
